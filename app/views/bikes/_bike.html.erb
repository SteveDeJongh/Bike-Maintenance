<div id="<%= dom_id bike %>">
  <p>
    <strong>Name:</strong>
    <%= bike.name %>
  </p>

  <p>
    <strong>Make:</strong>
    <%= bike.make %>
  </p>

  <p>
    <strong>Model:</strong>
    <%= bike.model %>
  </p>

  <p>
    <strong>Strava gear:</strong>
    <%= bike.strava_gear_id %>
  </p>

  <p>
    <strong>Retired on:</strong>
    <%= bike.retired_on %>
  </p>

</div>
