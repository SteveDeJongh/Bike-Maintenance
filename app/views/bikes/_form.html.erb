<%= form_with(model: bike) do |form| %>
  <% if bike.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(bike.errors.count, "error") %> prohibited this bike from being saved:</h2>

      <ul>
        <% bike.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :make, style: "display: block" %>
    <%= form.text_field :make %>
  </div>

  <div>
    <%= form.label :model, style: "display: block" %>
    <%= form.text_field :model %>
  </div>

  <div>
    <%= form.label :strava_gear_id, style: "display: block" %>
    <%= form.text_field :strava_gear_id %>
  </div>

  <div>
    <%= form.label :retired_on, style: "display: block" %>
    <%= form.date_field :retired_on %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
