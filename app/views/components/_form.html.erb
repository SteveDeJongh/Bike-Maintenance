<%= form_with(model: component) do |form| %>
  <% if component.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(component.errors.count, "error") %> prohibited this component from being saved:</h2>

      <ul>
        <% component.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :label, style: "display: block" %>
    <%= form.text_field :label %>
  </div>

  <div>
    <%= form.label :category, style: "display: block" %>
    <%= form.text_field :category %>
  </div>

  <div>
    <%= form.label :acquired_on, style: "display: block" %>
    <%= form.date_field :acquired_on %>
  </div>

  <div>
    <%= form.label :retired_on, style: "display: block" %>
    <%= form.date_field :retired_on %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
