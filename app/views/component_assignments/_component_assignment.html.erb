<div id="<%= dom_id component_assignment %>">
  <p>
    <strong>Component:</strong>
    <%= component_assignment.component.label %>
  </p>

  <p>
    <strong>Bike:</strong>
    <%= component_assignment.bike.name %>
  </p>

  <p>
    <strong>Started on:</strong>
    <%= component_assignment.started_on %>
  </p>

  <p>
    <strong>Ended on:</strong>
    <%= component_assignment.ended_on %>
  </p>

</div>
