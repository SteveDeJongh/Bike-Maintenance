<%= form_with(model: component_assignment) do |form| %>
  <% if component_assignment.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(component_assignment.errors.count, "error") %> prohibited this component_assignment from being saved:</h2>

      <ul>
        <% component_assignment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :component_id, style: "display: block" %>
    <%= form.collection_select :component_id, Component.all, :id, :label %>
  </div>

  <div>
    <%= form.label :bike_id, style: "display: block" %>
    <%= form.collection_select :bike_id, Bike.all, :id, :name %>
  </div>

  <div>
    <%= form.label :started_on, style: "display: block" %>
    <%= form.date_field :started_on %>
  </div>

  <div>
    <%= form.label :ended_on, style: "display: block" %>
    <%= form.date_field :ended_on %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
