<p style="color: green"><%= notice %></p>

<h1>Component assignments</h1>

<div id="component_assignments">
  <% @component_assignments.each do |component_assignment| %>
    <%= render component_assignment %>
    <p>
      <%= link_to "Show this component assignment", component_assignment %>
    </p>
  <% end %>
</div>

<%= link_to "New component assignment", new_component_assignment_path %>
